          "player_emotion_after": "idle"
        }
      ]
    },
    {
      "id": 31,
      "patient_says": "I'm scared that this is just who I am now. That it won't change.",
      "emotion": "concern",
      "choices": [
        {
          "text": "That fear is real and I don't want to dismiss it. But this is not who you are. This is what's happening to you right now.",
